# Microsoft Entra service principal (prefer Workload Identity Federation / OIDC; AZURE_CLIENT_SECRET is optional fallback)
AZURE_CLIENT_ID=<service-principal-application-client-id>
AZURE_TENANT_ID=<entra-directory-tenant-id>
AZURE_FEDERATED_TOKEN_FILE=<optional-path-to-oidc-jwt-token-file>
AZURE_CLIENT_SECRET=<optional-fallback-service-principal-client-secret>
AZURE_CLIENT_OBJECT_ID=<service-principal-object-id>

# Microsoft Fabric development workspace
FABRIC_WORKSPACE_ID=<fabric-workspace-id>
FABRIC_WORKSPACE_NAME=<fabric-workspace-name>
ACCELERATOR_DEV_WORKSPACE=<fabric-workspace-id>

# Server-side GitHub App deployment
GITHUB_AUTH_MODE=github-app
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_PRIVATE_KEY_PATH=<absolute-path-to-github-app-private-key-pem>
GITHUB_ALLOWED_REPOSITORIES=<owner/repository,owner/another-repository>

# Server-side GitLab CI deployment
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=<project-group-or-personal-access-token-with-api-scope>
GITLAB_ALLOWED_PROJECTS=<group/project,group/subgroup/another-project>
