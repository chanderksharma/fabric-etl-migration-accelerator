                    <SelectField field="Right_CustomerName" selected="True" rename="CustomerName" />
                    <SelectField field="Right_Tier" selected="True" rename="Tier" />
                    <SelectField field="Right_CustomerID" selected="False" />
                    <SelectField field="Right_Status" selected="False" />
                    <SelectField field="*Unknown" selected="False" />
                  </SelectFields>
                </Configuration>
              </SelectConfiguration>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name>Match on customer</Name>
              <DefaultAnnotationText>Join orders to active customers</DefaultAnnotationText>
              <Left value="False" />
