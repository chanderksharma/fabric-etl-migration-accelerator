{
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "README.md",
          "CONTRIBUTING.md",
          "SECURITY.md",
          "SUPPORT.md",
          "NOTICE.md",
          "docs/**/*.md"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          ".venv/**",
          "apps/**",
          "generated-fabric-workflows/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/**/*.png"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "Microsoft Fabric ETL Migration Accelerator",
      "_appName": "Fabric ETL Accelerator",
      "_enableSearch": true
    }
  }
}
