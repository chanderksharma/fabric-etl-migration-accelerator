<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="11/15/2026" REPOSITORY_VERSION="10.5">
  <REPOSITORY NAME="SyntheticRepository" VERSION="190">
    <FOLDER NAME="Finance" OWNER="etl-user" SHARED="NOTSHARED">
      <SOURCE DATABASETYPE="Flat File" NAME="Ledger_Src_File">
        <SOURCEFIELD DATATYPE="string" FIELDNUMBER="1" NAME="CurrentlyProcessedFileName"/>
        <SOURCEFIELD DATATYPE="string" FIELDNUMBER="2" NAME="AccountGroup"/>
        <SOURCEFIELD DATATYPE="decimal" FIELDNUMBER="3" NAME="Balance"/>
      </SOURCE>
      <TARGET DATABASETYPE="Microsoft SQL Server" NAME="STG_LEDGER_CONTENT">
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="1" NAME="AccountGroup"/>
        <TARGETFIELD DATATYPE="decimal" FIELDNUMBER="2" NAME="Balance"/>
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="3" NAME="File_Name"/>
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="4" NAME="CHANNEL"/>
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="5" NAME="REJECT_REASON"/>
      </TARGET>
      <TARGET DATABASETYPE="Flat File" NAME="UNPROCESSED_NORTH_FILE_LIST">
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="1" NAME="File_Name"/>
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="2" NAME="REJECT_REASON"/>
      </TARGET>
      <TARGET DATABASETYPE="Flat File" NAME="UNPROCESSED_SOUTH_FILE_LIST">
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="1" NAME="File_Name"/>
        <TARGETFIELD DATATYPE="string" FIELDNUMBER="2" NAME="REJECT_REASON"/>
      </TARGET>
      <MAPPING NAME="m_STG_Ledger_Validation" DESCRIPTION="Validate and route ledger feed files">
        <TRANSFORMATION NAME="SQ_Ledger_Src_File" TYPE="Source Qualifier"/>
        <TRANSFORMATION NAME="EXP_Date_Validation" TYPE="Expression">
          <TRANSFORMFIELD DATATYPE="string" NAME="CurrentlyProcessedFileName" PORTTYPE="INPUT/OUTPUT"/>
          <TRANSFORMFIELD DATATYPE="string" NAME="AccountGroup" PORTTYPE="INPUT/OUTPUT"/>
          <TRANSFORMFIELD DATATYPE="decimal" NAME="Balance" PORTTYPE="INPUT/OUTPUT"/>
          <TRANSFORMFIELD DATATYPE="string" EXPRESSION="LTRIM(RTRIM(CurrentlyProcessedFileName))" NAME="File_Name" PORTTYPE="OUTPUT"/>
          <TRANSFORMFIELD DATATYPE="string" EXPRESSION="IIF(AccountGroup = 'NORTH_REGION', 'NORTH', 'SOUTH')" NAME="CHANNEL" PORTTYPE="OUTPUT"/>
          <TRANSFORMFIELD DATATYPE="string" EXPRESSION="IIF(ISNULL(AccountGroup), 'Missing AccountGroup', NULL)" NAME="REJECT_REASON" PORTTYPE="OUTPUT"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="RTR_Ledger" TYPE="Router">
          <GROUP NAME="INPUT" TYPE="INPUT"/>
          <GROUP EXPRESSION="ISNULL(REJECT_REASON)" NAME="STG_DATA" TYPE="OUTPUT"/>
          <GROUP EXPRESSION="NOT(ISNULL(REJECT_REASON)) AND CHANNEL = 'NORTH'" NAME="NORTH_REJECTED" TYPE="OUTPUT"/>
          <GROUP EXPRESSION="NOT(ISNULL(REJECT_REASON)) AND CHANNEL = 'SOUTH'" NAME="SOUTH_REJECTED" TYPE="OUTPUT"/>
          <GROUP NAME="DEFAULT1" TYPE="OUTPUT/DEFAULT"/>
          <TRANSFORMFIELD GROUP="INPUT" NAME="AccountGroup" PORTTYPE="INPUT"/>
          <TRANSFORMFIELD GROUP="INPUT" NAME="Balance" PORTTYPE="INPUT"/>
          <TRANSFORMFIELD GROUP="INPUT" NAME="File_Name" PORTTYPE="INPUT"/>
          <TRANSFORMFIELD GROUP="INPUT" NAME="CHANNEL" PORTTYPE="INPUT"/>
          <TRANSFORMFIELD GROUP="INPUT" NAME="REJECT_REASON" PORTTYPE="INPUT"/>
          <TRANSFORMFIELD GROUP="STG_DATA" NAME="AccountGroup1" PORTTYPE="OUTPUT" REF_FIELD="AccountGroup"/>
          <TRANSFORMFIELD GROUP="STG_DATA" NAME="Balance1" PORTTYPE="OUTPUT" REF_FIELD="Balance"/>
          <TRANSFORMFIELD GROUP="STG_DATA" NAME="File_Name1" PORTTYPE="OUTPUT" REF_FIELD="File_Name"/>
          <TRANSFORMFIELD GROUP="STG_DATA" NAME="CHANNEL1" PORTTYPE="OUTPUT" REF_FIELD="CHANNEL"/>
          <TRANSFORMFIELD GROUP="STG_DATA" NAME="REJECT_REASON1" PORTTYPE="OUTPUT" REF_FIELD="REJECT_REASON"/>
          <TRANSFORMFIELD GROUP="NORTH_REJECTED" NAME="File_Name3" PORTTYPE="OUTPUT" REF_FIELD="File_Name"/>
          <TRANSFORMFIELD GROUP="NORTH_REJECTED" NAME="REJECT_REASON3" PORTTYPE="OUTPUT" REF_FIELD="REJECT_REASON"/>
          <TRANSFORMFIELD GROUP="SOUTH_REJECTED" NAME="File_Name4" PORTTYPE="OUTPUT" REF_FIELD="File_Name"/>
          <TRANSFORMFIELD GROUP="SOUTH_REJECTED" NAME="REJECT_REASON4" PORTTYPE="OUTPUT" REF_FIELD="REJECT_REASON"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="AGG_North_Rejects" TYPE="Aggregator">
          <TRANSFORMFIELD EXPRESSION="File_Name3" EXPRESSIONTYPE="GROUPBY" NAME="File_Name3" PORTTYPE="INPUT/OUTPUT"/>
          <TRANSFORMFIELD EXPRESSION="REJECT_REASON3" EXPRESSIONTYPE="GROUPBY" NAME="REJECT_REASON3" PORTTYPE="INPUT/OUTPUT"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="AGG_South_Rejects" TYPE="Aggregator">
          <TRANSFORMFIELD EXPRESSION="File_Name4" EXPRESSIONTYPE="GROUPBY" NAME="File_Name4" PORTTYPE="INPUT/OUTPUT"/>
          <TRANSFORMFIELD EXPRESSION="REJECT_REASON4" EXPRESSIONTYPE="GROUPBY" NAME="REJECT_REASON4" PORTTYPE="INPUT/OUTPUT"/>
        </TRANSFORMATION>
        <INSTANCE NAME="Ledger_Src_File" TRANSFORMATION_NAME="Ledger_Src_File" TYPE="SOURCE"/>
        <INSTANCE NAME="SQ_Ledger_Src_File" TRANSFORMATION_NAME="SQ_Ledger_Src_File" TYPE="TRANSFORMATION"/>
        <INSTANCE NAME="EXP_Date_Validation" TRANSFORMATION_NAME="EXP_Date_Validation" TYPE="TRANSFORMATION"/>
        <INSTANCE NAME="RTR_Ledger" TRANSFORMATION_NAME="RTR_Ledger" TYPE="TRANSFORMATION"/>
        <INSTANCE NAME="AGG_North_Rejects" TRANSFORMATION_NAME="AGG_North_Rejects" TYPE="TRANSFORMATION"/>
        <INSTANCE NAME="AGG_South_Rejects" TRANSFORMATION_NAME="AGG_South_Rejects" TYPE="TRANSFORMATION"/>
        <INSTANCE NAME="STG_LEDGER_CONTENT" TRANSFORMATION_NAME="STG_LEDGER_CONTENT" TYPE="TARGET"/>
        <INSTANCE NAME="UNPROCESSED_NORTH_FILE_LIST" TRANSFORMATION_NAME="UNPROCESSED_NORTH_FILE_LIST" TYPE="TARGET"/>
        <INSTANCE NAME="UNPROCESSED_SOUTH_FILE_LIST" TRANSFORMATION_NAME="UNPROCESSED_SOUTH_FILE_LIST" TYPE="TARGET"/>
        <CONNECTOR FROMFIELD="CurrentlyProcessedFileName" FROMINSTANCE="Ledger_Src_File" TOFIELD="CurrentlyProcessedFileName" TOINSTANCE="SQ_Ledger_Src_File"/>
        <CONNECTOR FROMFIELD="AccountGroup" FROMINSTANCE="Ledger_Src_File" TOFIELD="AccountGroup" TOINSTANCE="SQ_Ledger_Src_File"/>
        <CONNECTOR FROMFIELD="Balance" FROMINSTANCE="Ledger_Src_File" TOFIELD="Balance" TOINSTANCE="SQ_Ledger_Src_File"/>
        <CONNECTOR FROMFIELD="CurrentlyProcessedFileName" FROMINSTANCE="SQ_Ledger_Src_File" TOFIELD="CurrentlyProcessedFileName" TOINSTANCE="EXP_Date_Validation"/>
        <CONNECTOR FROMFIELD="AccountGroup" FROMINSTANCE="SQ_Ledger_Src_File" TOFIELD="AccountGroup" TOINSTANCE="EXP_Date_Validation"/>
        <CONNECTOR FROMFIELD="Balance" FROMINSTANCE="SQ_Ledger_Src_File" TOFIELD="Balance" TOINSTANCE="EXP_Date_Validation"/>
        <CONNECTOR FROMFIELD="AccountGroup" FROMINSTANCE="EXP_Date_Validation" TOFIELD="AccountGroup" TOINSTANCE="RTR_Ledger"/>
        <CONNECTOR FROMFIELD="Balance" FROMINSTANCE="EXP_Date_Validation" TOFIELD="Balance" TOINSTANCE="RTR_Ledger"/>
        <CONNECTOR FROMFIELD="File_Name" FROMINSTANCE="EXP_Date_Validation" TOFIELD="File_Name" TOINSTANCE="RTR_Ledger"/>
        <CONNECTOR FROMFIELD="CHANNEL" FROMINSTANCE="EXP_Date_Validation" TOFIELD="CHANNEL" TOINSTANCE="RTR_Ledger"/>
        <CONNECTOR FROMFIELD="REJECT_REASON" FROMINSTANCE="EXP_Date_Validation" TOFIELD="REJECT_REASON" TOINSTANCE="RTR_Ledger"/>
        <CONNECTOR FROMFIELD="AccountGroup1" FROMINSTANCE="RTR_Ledger" TOFIELD="AccountGroup" TOINSTANCE="STG_LEDGER_CONTENT"/>
        <CONNECTOR FROMFIELD="Balance1" FROMINSTANCE="RTR_Ledger" TOFIELD="Balance" TOINSTANCE="STG_LEDGER_CONTENT"/>
        <CONNECTOR FROMFIELD="File_Name1" FROMINSTANCE="RTR_Ledger" TOFIELD="File_Name" TOINSTANCE="STG_LEDGER_CONTENT"/>
        <CONNECTOR FROMFIELD="CHANNEL1" FROMINSTANCE="RTR_Ledger" TOFIELD="CHANNEL" TOINSTANCE="STG_LEDGER_CONTENT"/>
        <CONNECTOR FROMFIELD="REJECT_REASON1" FROMINSTANCE="RTR_Ledger" TOFIELD="REJECT_REASON" TOINSTANCE="STG_LEDGER_CONTENT"/>
        <CONNECTOR FROMFIELD="File_Name3" FROMINSTANCE="RTR_Ledger" TOFIELD="File_Name3" TOINSTANCE="AGG_North_Rejects"/>
        <CONNECTOR FROMFIELD="REJECT_REASON3" FROMINSTANCE="RTR_Ledger" TOFIELD="REJECT_REASON3" TOINSTANCE="AGG_North_Rejects"/>
        <CONNECTOR FROMFIELD="File_Name4" FROMINSTANCE="RTR_Ledger" TOFIELD="File_Name4" TOINSTANCE="AGG_South_Rejects"/>
        <CONNECTOR FROMFIELD="REJECT_REASON4" FROMINSTANCE="RTR_Ledger" TOFIELD="REJECT_REASON4" TOINSTANCE="AGG_South_Rejects"/>
        <CONNECTOR FROMFIELD="File_Name3" FROMINSTANCE="AGG_North_Rejects" TOFIELD="File_Name" TOINSTANCE="UNPROCESSED_NORTH_FILE_LIST"/>
        <CONNECTOR FROMFIELD="REJECT_REASON3" FROMINSTANCE="AGG_North_Rejects" TOFIELD="REJECT_REASON" TOINSTANCE="UNPROCESSED_NORTH_FILE_LIST"/>
        <CONNECTOR FROMFIELD="File_Name4" FROMINSTANCE="AGG_South_Rejects" TOFIELD="File_Name" TOINSTANCE="UNPROCESSED_SOUTH_FILE_LIST"/>
        <CONNECTOR FROMFIELD="REJECT_REASON4" FROMINSTANCE="AGG_South_Rejects" TOFIELD="REJECT_REASON" TOINSTANCE="UNPROCESSED_SOUTH_FILE_LIST"/>
      </MAPPING>
      <SESSION MAPPINGNAME="m_STG_Ledger_Validation" NAME="s_STG_Ledger_Validation"/>
      <WORKFLOW NAME="wf_STG_Ledger_Validation" SCHEDULERNAME="Daily">
        <TASKINSTANCE NAME="Start" TASKNAME="Start" TASKTYPE="Start"/>
        <TASKINSTANCE NAME="s_STG_Ledger_Validation" TASKNAME="s_STG_Ledger_Validation" TASKTYPE="Session"/>
        <WORKFLOWLINK FROMTASK="Start" TOTASK="s_STG_Ledger_Validation"/>
      </WORKFLOW>
      <SCHEDULER NAME="Daily" REUSABLE="YES" SCHEDULEINFO="Every day"/>
    </FOLDER>
  </REPOSITORY>
</POWERMART>
